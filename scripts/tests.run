# Run from the project root:   ampl scripts/tests.run
# (or in the AMPL console:     include scripts/tests.run;)
#
# After each result, "warning:" lists courses with no ALLOWED_PATTERNS entry
# (the model lets those use every pattern) and in-person courses with no
# eligible room (the model is then infeasible). "not offered:" lists cohort course
# numbers with no course this term (fine for semester-specific courses).

reset;
option solver highs;            # or cbc, gurobi, cplex -- any MIP solver
option solver_msg 0;            # keep the output short
model models/scheduling.mod;

# ---------- Test 0: Fall 2026 instance ----------
reset data;
data data/fall2026_sets.dat;
solve;
printf "\nTEST 0 fall2026         expect: solved      got: %s\n", solve_result;
if card(UNLISTED) > 0 then {
  printf "   warning: no ALLOWED_PATTERNS (all patterns used):"; printf {c in UNLISTED} " %s", c; printf "\n"; }
if card(COHORT_MISSING) > 0 then {
  printf "   not offered:"; printf {(h,n) in COHORT_MISSING} " %s/%s", h, n; printf "\n"; }
if card(NO_ROOM) > 0 then {
  printf "   warning: no eligible room:"; printf {c in NO_ROOM} " %s", c; printf "\n"; }
printf "   score: %g   cohort overlaps: %g\n", Score, sum {(h,c1,c2) in COHORT_PAIRS} Overlap[h,c1,c2];
printf {c in NONLABS, r in ROOMS_OF[c], (p,b) in SLOTS[c]: x[c,r,p,b] > 0.5}
    "   %-4s %-4s %-4s %s\n", c, r, p, b;
printf {c in LABS, r in ROOMS_OF[c], (p,b) in LAB_SLOTS[c]: y[c,r,p,b] > 0.5}
    "   %-4s %-4s %-4s %s + %s  (lab)\n", c, r, p, b, b + 1;

# ---------- Test 1: feasible instance ----------
reset data;
data data/tests/test_base.dat;
solve;
printf "\nTEST 1 base             expect: solved      got: %s\n", solve_result;
if card(UNLISTED) > 0 then {
  printf "   warning: no ALLOWED_PATTERNS (all patterns used):"; printf {c in UNLISTED} " %s", c; printf "\n"; }
if card(COHORT_MISSING) > 0 then {
  printf "   not offered:"; printf {(h,n) in COHORT_MISSING} " %s/%s", h, n; printf "\n"; }
if card(NO_ROOM) > 0 then {
  printf "   warning: no eligible room:"; printf {c in NO_ROOM} " %s", c; printf "\n"; }
printf {c in NONLABS, r in ROOMS_OF[c], (p,b) in SLOTS[c]: x[c,r,p,b] > 0.5}
    "   %-4s %-4s %-4s %s\n", c, r, p, b;
printf {c in LABS, r in ROOMS_OF[c], (p,b) in LAB_SLOTS[c]: y[c,r,p,b] > 0.5}
    "   %-4s %-4s %-4s %s + %s  (lab)\n", c, r, p, b, b + 1;

