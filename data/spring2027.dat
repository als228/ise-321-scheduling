set COHORT_NUMS :=
  sophomore 111   sophomore 131   sophomore 112   sophomore 132   sophomore 121
  junior 230   junior 240   junior 224   junior 226
  junior 308   junior 172   junior 215   junior 216
  senior 251   senior 254 ;
