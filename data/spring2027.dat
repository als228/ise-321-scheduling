# ===================== ONLINE =====================
# courses taught fully online: no room, no room clash
set ONLINE := ;

# ===================== DEPARTMENT RULES =====================
# block 3 = 10:45, block 4 = 12:10
set CLOSED := Thu 3   Tue 4 ;               # no classes at all
set ROOM_CLOSED := MO453 Tue 3   MO375 Thu 4 ;
set GRAD_CLOSED := Thu 4 ;                  # no 4XX courses (incl. cross-listed)

# Thu block 4: only Pamukcu, Zimmers, Perevalov and Zuluaga may teach.
# Every other professor this term is closed then. When adding a professor,
# add them here too unless they are allowed on Thu 4.
set PROF_CLOSED :=
  Akus Thu 4   Alexandrescu Thu 4   Curtis Thu 4   Goldberg Thu 4
  Liza Thu 4   Marangos Thu 4   Motsko Thu 4   Nyberg Thu 4
  Paredes Thu 4   Ralphs Thu 4   Shabnam Thu 4   Terlaky Thu 4
  Tosin Thu 4 ;

# ===================== PREFERENCES (soft) =====================
# From faculty requests for Spring 2027. Rows are keyed by professor (all
# their courses) or by course (that course only; overrides the professor).
# Blocks: 1 = 7:55  2 = 9:20  3 = 10:45  4 = 12:10  5 = 1:35  6 = 3:00
#         7 = 4:25  8 = 5:50.  Weight: 1 = want, 0.5 = OK, -1 = avoid.
param: PREF_BLOCK: pref_block :=
  # Pamukcu (Derya): afternoons, late afternoon OK; none before 10:45
  Pamukcu 1 -1   Pamukcu 2 -1   Pamukcu 5 1   Pamukcu 6 1   Pamukcu 7 1
  # Paredes: lunch (12:10) or after 5 PM; day doesn't matter
  Paredes 4 1   Paredes 8 1
  # Zhao: ISE240 MW 12:10, as in Spring 2026
  ISE240 4 1
  # Zuluaga: ISE347/447 TR 3:00, as in Spring 2026 (flexible)
  ISE347_447 6 1
  # Nyberg: 4:25-7:05 one evening a week (assumed to be ISE336/436)
  ISE336_436 7 1   ISE336_436 8 1
  # Perevalov: morning to noon, MW or TR
  Perevalov 1 1   Perevalov 2 1   Perevalov 3 1   Perevalov 4 1
  # Terlaky: TR afternoons
  Terlaky 5 1   Terlaky 6 1   Terlaky 7 1   Terlaky 8 1
  # Goldberg: ISE411 afternoons, MW first, else TR
  Goldberg 5 1   Goldberg 6 1   Goldberg 7 1   Goldberg 8 1
  # Ralphs: ISE172 later than 9:20, ideally 12-4; ISE418 early afternoon
  ISE172 3 0.5   ISE172 4 1   ISE172 5 1   ISE172 6 1
  ISE418 4 1   ISE418 5 1   ISE418 6 0.5
  # Curtis: TR late morning or afternoon, ending before 5 PM
  Curtis 3 1   Curtis 4 1   Curtis 5 1   Curtis 6 1
  # Zimmers: as in Spring 2026. ISE254 TR 12:10 (note: Tue 4 is CLOSED),
  # ISE254 lab F 10:45-1:25, ISE382/482 F 1:35-4:15
  ISE254 4 1
  ISE254_W 3 1   ISE254_W 4 1
  ISE382_482 5 1   ISE382_482 6 1 ;

param: PREF_PATTERN: pref_pattern :=
  ISE240 MW 1
  ISE347_447 TR 1
  Perevalov MW 1   Perevalov TR 1
  Terlaky TR 1
  Goldberg MW 1   Goldberg TR 0.5
  Curtis TR 1
  ISE254 TR 1   ISE254_W F 1   ISE382_482 F 1 ;

