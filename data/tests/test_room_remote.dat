# Remote async courses need remote_ready rooms -- should be infeasible
# Two rooms give four TR slots for three TR courses, but all three have a
# remote async section and only R1 is remote_ready.
set COURSES    := A  B  C ;
set PROFESSORS := P1  P2  P3 ;
param: ROOMS: remote_ready :=
  R1  1
  R2  0 ;
set LABS       := ;
set DAYS       := Mon  Tue  Wed  Thu  Fri ;
param K        := 2 ;
set PATTERNS   := MW  TR ;
set DAYS_OF[MW] := Mon Wed ;
set DAYS_OF[TR] := Tue Thu ;
param instructor := A P1   B P2   C P3 ;
set ALLOWED_PATTERNS[A] := TR ;
set ALLOWED_PATTERNS[B] := TR ;
set ALLOWED_PATTERNS[C] := TR ;
set REMOTE := A  B  C ;
