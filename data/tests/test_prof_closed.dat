# Professor closed -- should be INFEASIBLE
# Two TR courses in one room need TR1 and TR2. Both professors are closed on
# Thu block 2 (ProfClosed), so both would need TR1.
set COURSES    := A  B ;
set LABS       := ;
set PROFESSORS := P1  P2 ;
set ROOMS      := R1 ;
set DAYS       := Mon  Tue  Wed  Thu  Fri ;
param K        := 2 ;
set PATTERNS   := MW  TR ;
set DAYS_OF[MW] := Mon Wed ;
set DAYS_OF[TR] := Tue Thu ;
param instructor := A P1   B P2 ;
set ALLOWED_PATTERNS[A] := TR ;
set ALLOWED_PATTERNS[B] := TR ;
set PROF_CLOSED := P1 Thu 2   P2 Thu 2 ;
