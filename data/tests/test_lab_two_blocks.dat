# One room, two blocks. The Monday lab can only start at b1, so it fills
# b1 AND b2 on Monday. Lecture A (MW) then has nowhere to go.
# -> infeasible ONLY if the lab correctly blocks its second block
set COURSES    := A  L1 ;
set LABS       := L1 ;
set PROFESSORS := P1  P2 ;
set ROOMS      := R1 ;
set DAYS       := Mon  Tue  Wed  Thu  Fri ;
set BLOCKS     := b1  b2 ;
set PATTERNS   := MW  M ;
set DAYS_OF[MW] := Mon Wed ;
set DAYS_OF[M]  := Mon ;
param teacher := A P1   L1 P2 ;
